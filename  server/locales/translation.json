const express = require('express');
const path = require('path');

const app = express();
const PORT = process.env.PORT || 3006;

app.use(express.json());
app.use(express.static(path.join(__dirname, 'public')));

const BIGISH_YER_POOL = {
    piReserve: "1000000",
    yerReserve: "15000000000",
    precisionFactor: "10000000"
};

const localDictionary = {
    "ar": { "title": "بروتوكول أمان للتأمين اللامركزي" },
    "en": { "title": "AMAN Decentralized Insurance Protocol" }
};

app.post('/api/insurance/process-secure', (req, res) => {
    try {
        const { role, username, type, usdValue, details } = req.body;
        console.log("[KYC Check] Match complete for user: " + username);

        const basePremiumUSD = parseFloat(usdValue || 0) * 0.02;
        const simulatedRiskModifier = 1.25;
        const finalPremiumUSD = basePremiumUSD * simulatedRiskModifier;

        const piRateInUSD = 40;
        const calculatedPremiumPi = (finalPremiumUSD / piRateInUSD).toFixed(4);

        res.json({
            success: true,
            username: username,
            role: role,
            premiumUSD: finalPremiumUSD.toFixed(2),
            calculatedPremiumPi: calculatedPremiumPi,
            aiDecision: "APPROVED: Data packet routed to secure framework core.",
            clearingEngine: "INTEGRATED-WITH-BIGISH-YER",
            poolState: BIGISH_YER_POOL
        });
    } catch (error) {
        res.status(500).json({ success: false, error: "Processing error" });
    }
});

app.get('/api/localization', (req, res) => {
    const userBrowserLang = req.headers['accept-language'] || 'en';
    const preferredLang = userBrowserLang.split(',')[0].split('-')[0].trim().toLowerCase();
    const selectedStrings = localDictionary[preferredLang] || localDictionary['en'];
    
    res.json({ lang: preferredLang, strings: selectedStrings });
});

app.listen(PORT, () => {
    console.log("[AMAN Secure Server] Activated on port: " + PORT);
});
