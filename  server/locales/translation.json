const express = require('express');
const path = require('path');
const languageManager = require('./locales/languageManager');

const app = express();
const PORT = process.env.PORT || 3006;

app.use(express.json());
app.use(express.static(path.join(__dirname, 'public')));

// AMAN & BIGISH-YER Core Pool Settings using standard BigInt initialization
const BIGISH_YER_POOL = {
    piReserve: BigInt("1000000"),
    yerReserve: BigInt("15000000000"),
    precisionFactor: BigInt("10000000")
};

// Main dynamic premium and insurance processing endpoint
app.post('/api/insurance/process-secure', (req, res) => {
    try {
        const { role, username, type, usdValue, details } = req.body;

        // 1. Core Pi KYC Verification simulation log
        console.log("[KYC Verification] Account matched successfully for: " + username);

        // 2. Risk Predictive Engine Processing
        const basePremiumUSD = parseFloat(usdValue || 0) * 0.02;
        const simulatedRiskModifier = 1.25;
        const finalPremiumUSD = basePremiumUSD * simulatedRiskModifier;

        // 3. Constant conversion mapping for Sandbox AMM
        const piRateInUSD = 40;
        const calculatedPremiumPi = (finalPremiumUSD / piRateInUSD).toFixed(4);

        // 4. Secure dynamic response presentation
        res.json({
            success: true,
            username: username,
            role: role,
            premiumUSD: finalPremiumUSD.toFixed(2),
            calculatedPremiumPi: calculatedPremiumPi,
            aiDecision: "APPROVED: Data packet routed to the validation network. Direct automated alerts dispatched to field units.",
            clearingEngine: "INTEGRATED-WITH-BIGISH-YER",
            poolState: {
                piReserve: BIGISH_YER_POOL.piReserve.toString(),
                yerReserve: BIGISH_YER_POOL.yerReserve.toString()
            }
        });
    } catch (error) {
        console.error("[AMAN Server Error]:", error);
        res.status(500).json({ success: false, error: "Critical insurance processing error" });
    }
});

// Localization routing interface
app.get('/api/localization', (req, res) => {
    const userBrowserLang = req.headers['accept-language'];
    res.json(languageManager.detectAndGetTranslation(userBrowserLang));
});

app.listen(PORT, () => {
    console.log("[A.E.C. AMAN] Secure Server activated successfully on port: " + PORT);
});
